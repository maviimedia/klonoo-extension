{
  "manifest_version": 3,
  "name": "Klonoo",
  "version": "2.0.0",
  "description": "The ultimate web extraction tool: Pixel-perfect code cloning, full-page snapshots, tech stack detection, and design system export.",
  "icons": {
    "16": "klonoo—ICON16.png",
    "48": "klonoo—ICON48.png",
    "128": "klonoo—ICON128.png"
  },
  "action": {
    "default_title": "Open Klonoo"
  },
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "*.png",
        "*.svg",
        "*.css",
        "manrope/*.ttf"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}